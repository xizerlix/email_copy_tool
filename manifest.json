{
  "manifest_version": 3,
  "name": "Email Copy Tool",
  "version": "1.0",
  "description": "Automatically copies emails with specific domains on a specific resource to the buffer",
  "permissions": ["storage", "clipboardWrite"],
  "action": {
    "default_popup": "options.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}